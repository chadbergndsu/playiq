# Copy to .env for local tooling outside the live preview.
# Never commit real secrets. Platform deploy injects production values.

# --- Database (Postgres) ---
# Live preview uses embedded PGLite when unset.
# DATABASE_URL=postgresql://user:password@host:5432/playiq?sslmode=require

# --- Auth (Better Auth + Grok broker) ---
# Live preview uses baked preview client when unset.
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=https://your-production-host.example

# Optional: disable sign-in for non-auth demos (defaults ON)
# VITE_AUTH_ENABLED=true

# --- Public / client ---
# VITE_PUBLIC_HOSTNAME=your-production-host.example

# --- Observability (production) ---
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# --- AI / SpaceXAI (server-only; never expose to the browser) ---
# Used by POST /api/film/tag for real play tagging. Without it, heuristics run.
# Get a key: https://console.x.ai → API Keys
# XAI_API_KEY=
# Optional model override (default: grok-4.5)
# XAI_MODEL=grok-4.5
